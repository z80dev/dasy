(defn testRawCall [[to address] [x uint256] [y uint256]] uint256 :external
  (defvar res (bytes 32)
    (raw_call to
              (concat (method_id "multiply(uint256,uint256)")
                         (convert x bytes32)
                         (convert y bytes32))
              :max_outsize 32
              :gas 100000
              :value 0
              ))
  (defvar z uint256 (convert res uint256))
  z)

(defn sendEth [[to address]] [:external :payable]
  (raw_call to b"" :value msg/value))

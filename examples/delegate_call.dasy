(defvars x (public uint256)
         y (public uint256))

(defn updateX [[to address] [x uint256]] :external
  (raw_call to
            (concat
             (method_id "updateX(uint256)")
             (convert x bytes32))
            :is_delegate_call True))

(defn updateY [[to address] [y uint256]] :external
  (raw_call to
            (concat
             (method_id "updateY(uint256)")
             (convert y bytes32))
            :is_delegate_call True))

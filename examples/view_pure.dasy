(defvar num (public uint256))

;; Pure functions do not read any state or global variables
(defn pureFunc [[x uint256]] uint256 [:external :pure]
  x)

;; View functions might read state or global state, or call an internal function
(defn viewFunc [[x uint256]] bool [:external :view]
  (> x self/num))

(defn sum [[x uint256] [y uint256] [z uint256]] uint256 [:external :pure]
  (+ x  y z))

(defn addNum [[x uint256]] uint256 [:external :view]
  (+ x self/num))

(defvars
    owner (public address)
    eth (public uint256))

(defn setOwner [[owner address]] :external
  (set self/owner owner))

(defn sendEth [] [:external :payable]
  (set self/eth msg/value))

(defn setOwnerAndSendEth [[owner address]] [:external :payable]
  (set self/owner owner)
  (set self/eth msg/value))
